# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/financial_tracker

# Logging Configuration

# Log Format: pretty (colored, human-readable), json (structured), compact (minimal)
# Development: pretty | Production: json
LOG_FORMAT=pretty

# Log Level: error, warn, info, debug, trace
# Default includes specific levels for different components
# Development: debug | Production: info
RUST_LOG=info,sqlx=warn,tower_http=debug,axum=debug,fta_server=debug

# File Logging: true to enable daily rotating file logs in ./logs directory
# Development: false | Production: true
LOG_TO_FILE=false

# Server Configuration
# SERVER_PORT=3000
# SERVER_HOST=0.0.0.0
BASE_URL=http://localhost:3000
APP_NAME=Financial Tracker

# Authentication Configuration

# JWT Secret - Use a strong random string in production
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-here-change-in-production

# SMTP Configuration for Email Sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Financial Tracker

# Google OAuth Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Examples for Different Environments:

# --- Development ---
# LOG_FORMAT=pretty
# RUST_LOG=debug
# LOG_TO_FILE=false

# --- Staging ---
# LOG_FORMAT=json
# RUST_LOG=info,sqlx=warn
# LOG_TO_FILE=true

# --- Production ---
# LOG_FORMAT=json
# RUST_LOG=info,sqlx=warn,tower_http=info
# LOG_TO_FILE=true

# --- Debugging Specific Module ---
# RUST_LOG=info,fta_users=trace,fta_accounts=debug

# --- Minimal Logging (High Traffic) ---
# RUST_LOG=warn,fta_server=info
