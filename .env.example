# =============================================================================
# Axum Clean Architecture - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/axum_clean_arch

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Secret key for signing JWT tokens (use a strong random string in production)
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Access token expiry in minutes (default: 15)
# JWT_ACCESS_TOKEN_EXPIRY=15

# Refresh token expiry in minutes (default: 10080 = 7 days)
# JWT_REFRESH_TOKEN_EXPIRY=10080

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Host to bind the server to
HOST=0.0.0.0

# Port to run the server on
PORT=3000

# Base URL for the application (used in emails, OAuth callbacks, etc.)
BASE_URL=http://localhost:3000

# Application name (used in emails)
APP_NAME=Axum Clean Architecture

# -----------------------------------------------------------------------------
# Email Configuration (SMTP)
# -----------------------------------------------------------------------------
# SMTP server host
SMTP_HOST=smtp.gmail.com

# SMTP server port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP authentication username
SMTP_USER=your-email@gmail.com

# SMTP authentication password (use app-specific password for Gmail)
SMTP_PASS=your-app-specific-password

# Email address to send from
SMTP_FROM_EMAIL=noreply@yourdomain.com

# Name to display in the "From" field
SMTP_FROM_NAME=Axum Clean Architecture

# -----------------------------------------------------------------------------
# Google OAuth 2.0 Configuration
# -----------------------------------------------------------------------------
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level filter
# Options: trace, debug, info, warn, error
# Format: RUST_LOG=info,module=level,other_module=level
RUST_LOG=info,tower_http=debug,axum=debug,sqlx=warn

# Log output format
# Options: pretty, json, compact
LOG_FORMAT=pretty

# Enable logging to file (in addition to stdout)
LOG_TO_FILE=false

# Log file path (only used if LOG_TO_FILE=true)
# LOG_FILE_PATH=./logs/app.log

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Maximum requests per second per IP address
# RATE_LIMIT_PER_SECOND=50

# Rate limit burst size
# RATE_LIMIT_BURST=100

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Maximum request body size in bytes (default: 1MB)
# MAX_BODY_SIZE=1048576

# CORS allowed origins (comma-separated, or * for all)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
